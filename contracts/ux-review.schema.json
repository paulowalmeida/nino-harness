{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nino.delivery/contracts/ux-review.schema.json",
  "title": "UX Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "taskId", "designId", "scope", "criteria", "findings", "limitations", "status"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "designId": { "type": ["string", "null"] },
    "scope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "result", "evidence"],
        "properties": {
          "criterion": { "type": "string", "minLength": 1 },
          "result": { "enum": ["PASS", "FAIL", "NEEDS-EVIDENCE", "NOT-APPLICABLE"] },
          "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "category", "evidence", "recommendation", "probableOwner"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["blocker", "high", "medium", "low"] },
          "category": { "enum": ["visual", "interaction", "accessibility", "responsive", "internationalization", "design-system", "content"] },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "recommendation": { "type": "string", "minLength": 1 },
          "probableOwner": { "enum": ["ux-ui", "frontend-dev", "backend-dev", "product-owner", "architecture"] }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "status": { "enum": ["PASS", "FAIL", "NEEDS-EVIDENCE", "BLOCKED", "NOT-APPLICABLE"] }
  }
}
