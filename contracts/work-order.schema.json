{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nino Work Order",
  "type": "object",
  "required": [
    "objective",
    "repositories",
    "scope",
    "outOfScope",
    "verifiedEvidence",
    "decisionsRequired",
    "delegationGraph",
    "requiredGates",
    "status"
  ],
  "properties": {
    "objective": { "type": "string", "minLength": 1 },
    "repositories": { "type": "array", "items": { "type": "string" } },
    "scope": { "type": "array", "items": { "type": "string" } },
    "outOfScope": { "type": "array", "items": { "type": "string" } },
    "verifiedEvidence": { "type": "array", "items": { "type": "string" } },
    "decisionsRequired": { "type": "array", "items": { "type": "string" } },
    "delegationGraph": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "order",
          "sourceAgent",
          "agent",
          "task",
          "dependsOn",
          "dispatchId",
          "acceptanceCriteria",
          "requiredOutput"
        ],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "sourceAgent": { "const": "tech-lead" },
          "agent": { "type": "string", "minLength": 1 },
          "task": { "type": "string", "minLength": 1 },
          "dependsOn": { "type": "array", "items": { "type": "integer" } },
          "dispatchId": { "type": "string", "minLength": 1 },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "requiredOutput": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "requiredGates": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "status": {
      "enum": ["NEEDS-DECISION", "READY-FOR-EXECUTION", "BLOCKED", "INCOMPLETE"]
    }
  },
  "additionalProperties": false
}
