{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nino Environment Plan",
  "type": "object",
  "required": ["id", "taskId", "environments", "targets", "checks", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "taskId": { "type": "string", "minLength": 1 },
    "environments": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "targets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "checks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "risks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "status": { "enum": ["READY", "BLOCKED", "NEEDS-EVIDENCE"] }
  },
  "additionalProperties": false
}
