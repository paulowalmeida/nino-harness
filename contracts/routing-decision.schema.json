{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nino QA Routing Decision",
  "type": "object",
  "required": ["id", "taskId", "sourceQaHandoff", "findings", "iteration", "decision", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "taskId": { "type": "string", "minLength": 1 },
    "sourceQaHandoff": { "type": "string", "minLength": 1 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "probableOwner", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["blocker", "critical", "high", "medium", "low"] },
          "probableOwner": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "iteration": { "type": "integer", "minimum": 1, "maximum": 3 },
    "decision": { "enum": ["ROUTE-CORRECTION", "RETURN-TO-QA", "READY-FOR-BUSINESS-REGRESSION", "NEEDS-EVIDENCE", "BLOCKED"] },
    "nextAgents": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "status": { "enum": ["IN-PROGRESS", "READY-FOR-BUSINESS-REGRESSION", "BLOCKED", "DONE"] }
  },
  "additionalProperties": false
}
