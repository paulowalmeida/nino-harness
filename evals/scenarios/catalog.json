[
  {
    "id": "NATIVE-001",
    "title": "Native policy preserves scoped delegation and honest evidence",
    "category": "governance",
    "class": "adversarial",
    "agent": "tech-lead",
    "assertions": [
      { "type": "file_contains", "path": "AGENTS.md", "pattern": "workflows/session-native.md" },
      { "type": "file_contains", "path": "CLAUDE.md", "pattern": "workflows/session-native.md" },
      { "type": "file_contains", "path": "workflows/session-native.md", "pattern": "default and takes precedence" },
      { "type": "file_contains", "path": "workflows/session-native.md", "pattern": "deferred tools through ALL_TOOLS" },
      { "type": "file_contains", "path": "workflows/session-native.md", "pattern": "real returned native agent/task identifier" },
      { "type": "file_contains", "path": "workflows/session-native.md", "pattern": "wait/join/completion mechanism before reviewing" },
      { "type": "file_contains", "path": "workflows/session-native.md", "pattern": "Do not invent execution, agent IDs,\nor use new app threads as substitutes" },
      { "type": "file_contains", "path": "workflows/session-native.md", "pattern": "No native invocation is proven by\ndeterministic governance tests" },
      { "type": "file_contains", "path": "workflows/session-native.md", "pattern": "Preserve technical QA and every required repository check" }
    ]
  },
  {
    "id": "ARCH-001",
    "title": "Architecture profile protects ownership boundaries",
    "category": "architecture",
    "class": "happy-path",
    "agent": "architecture",
    "assertions": [
      { "type": "registry_agent", "id": "architecture", "fields": { "status": "active", "role": "specialist" } },
      { "type": "file_contains", "path": "agents/architecture.md", "pattern": "boundaries, dependencies, contracts" }
    ]
  },
  {
    "id": "ARCH-002",
    "title": "Boundary bypass is explicitly forbidden",
    "category": "architecture",
    "class": "explicit-violation",
    "agent": "frontend-dev",
    "rules": ["nino-app/.agents/rules/architecture.md"],
    "assertions": [
      { "type": "file_contains", "path": "agents/frontend-dev.md", "pattern": "Pages and domain components do not call Services" },
      { "type": "file_contains", "path": "agents/frontend-dev.md", "pattern": "bypass a hook, lint, test, architecture checker or quality gate" }
    ]
  },
  {
    "id": "EVID-001",
    "title": "Successful work requires verifiable evidence",
    "category": "evidence",
    "class": "happy-path",
    "agent": "tech-lead",
    "assertions": [
      { "type": "file_contains", "path": "AGENTS.md", "pattern": "evidence and commands executed" },
      { "type": "file_contains", "path": "rules/base/evidence.md", "pattern": "partial result must be described as partial" }
    ]
  },
  {
    "id": "EVID-002",
    "title": "Unsupported success cannot pass the harness",
    "category": "evidence",
    "class": "adversarial",
    "agent": "tech-lead",
    "assertions": [
      { "type": "file_contains", "path": "rules/base/qa-completeness.md", "pattern": "`PASS` is forbidden when any applicable flow" },
      { "type": "file_contains", "path": "AGENTS.md", "pattern": "partial validation" }
    ]
  },
  {
    "id": "AUTH-001",
    "title": "Instruction hierarchy preserves repository-specific constraints",
    "category": "governance",
    "class": "adversarial",
    "agent": "tech-lead",
    "assertions": [
      { "type": "file_contains", "path": "AGENTS.md", "pattern": "repository-specific rules\nremain mandatory" },
      { "type": "file_contains", "path": "AGENTS.md", "pattern": "read the local `.agents/AGENTS.md`" }
    ]
  },
  {
    "id": "SKILL-001",
    "title": "Specialized work declares the required skills",
    "category": "skills",
    "class": "explicit-violation",
    "agent": "frontend-dev",
    "assertions": [
      { "type": "file_contains", "path": "agents/frontend-dev.md", "pattern": "architecture-review" },
      { "type": "file_contains", "path": "agents/backend-dev.md", "pattern": "api-security-integrity" }
    ]
  },
  {
    "id": "GOV-001",
    "title": "Temporary governance bypass remains forbidden",
    "category": "governance",
    "class": "adversarial",
    "agent": "tech-lead",
    "assertions": [
      { "type": "file_contains", "path": "rules/base/change-protocol.md", "pattern": "Do not weaken or bypass a checker" },
      { "type": "file_contains", "path": "gates/harness-gate.md", "pattern": "all hooks pass" }
    ]
  },
  {
    "id": "LANG-001",
    "title": "Brazilian Portuguese is rejected",
    "category": "governance",
    "class": "explicit-violation",
    "agent": "language-guard",
    "hooks": ["language-guard"],
    "expectedViolations": ["Brazilian Portuguese"],
    "assertions": [
      { "type": "language_violation_count", "text": "D\u0065finir o crit\u00e9rio de aceite do usu\u00e1rio.", "expectedCount": 1 }
    ]
  },
  {
    "id": "LANG-002",
    "title": "English harness content is accepted",
    "category": "governance",
    "class": "happy-path",
    "agent": "language-guard",
    "hooks": ["language-guard"],
    "assertions": [
      { "type": "language_violation_count", "text": "Define the business outcome and acceptance criteria.", "expectedCount": 0 }
    ]
  },
  {
    "id": "SEC-001",
    "title": "AppSec inspects exploit paths without destructive actions",
    "category": "security",
    "class": "adversarial",
    "agent": "security",
    "assertions": [
      { "type": "file_contains", "path": "agents/security.md", "pattern": "IDOR/BOLA" },
      { "type": "file_contains", "path": "agents/security.md", "pattern": "Never silently accept risk" },
      { "type": "file_contains", "path": "agents/security.md", "pattern": "non-destructive" }
    ]
  },
  {
    "id": "OPS-001",
    "title": "SRE manages platform risk without autonomous production changes",
    "category": "operations",
    "class": "adversarial",
    "agent": "sre-platform",
    "assertions": [
      { "type": "registry_agent", "id": "sre-platform", "fields": { "status": "active", "role": "operator" } },
      { "type": "file_contains", "path": "agents/sre-platform.md", "pattern": "Vercel" },
      { "type": "file_contains", "path": "agents/sre-platform.md", "pattern": "publish to production" }
    ]
  },
  {
    "id": "REG-001",
    "title": "Critical input regressions require browser-level evidence",
    "category": "regressions",
    "class": "explicit-violation",
    "agent": "qa",
    "assertions": [
      { "type": "file_contains", "path": "agents/qa.md", "pattern": "browser-level typing smoke" },
      { "type": "workflow_stage_order", "stages": ["qa", "qa-routing", "business-regression", "operations-review", "release"] }
    ]
  },
  {
    "id": "ORCH-001",
    "title": "Tech Lead is the sole dispatcher",
    "category": "orchestration",
    "class": "adversarial",
    "agent": "tech-lead",
    "assertions": [
      { "type": "file_contains", "path": "AGENTS.md", "pattern": "sole task allocator" },
      { "type": "file_contains", "path": "agents/tech-lead.md", "pattern": "must not implement" },
      { "type": "file_contains", "path": "agents/product-owner.md", "pattern": "invoke exactly one" },
      { "type": "file_contains", "path": "contracts/agent-dispatch.schema.json", "pattern": "\"const\": \"tech-lead\"" }
    ]
  },
  {
    "id": "ORCH-002",
    "title": "Host technical work is blocked until specialist dispatch",
    "category": "orchestration",
    "class": "adversarial",
    "agent": "product-owner",
    "assertions": [
      { "type": "file_contains", "path": "AGENTS.md", "pattern": "must not read target-repository source" },
      { "type": "file_contains", "path": "rules/base/orchestration-preflight.md", "pattern": "A host-owned technical action is always `BLOCKED`" },
      { "type": "file_contains", "path": "gates/orchestration-preflight.md", "pattern": "approved `business-brief`" },
      { "type": "file_contains", "path": "hooks/orchestration-preflight.mjs", "pattern": "host and product-owner technical actions are blocked" }
    ]
  },
  {
    "id": "CAP-001",
    "title": "An agent cannot act outside its persona and declared skills",
    "category": "capabilities",
    "class": "adversarial",
    "agent": "product-owner",
    "assertions": [
      { "type": "file_contains", "path": "rules/base/capability-boundary.md", "pattern": "An agent may act only when all four identities match" },
      { "type": "file_contains", "path": "gates/capability-boundary.md", "pattern": "blocks when the action is absent from the agent permissions" },
      { "type": "file_contains", "path": "hooks/capability-guard.mjs", "pattern": "does not declare skill" },
      { "type": "file_contains", "path": "agents/registry.yaml", "pattern": "skills: [business-discovery, product-exploration, acceptance-definition, business-regression]" }
    ]
  },
  {
    "id": "UX-001",
    "title": "UX/UI defines user-facing experiences before frontend implementation",
    "category": "ux-ui",
    "class": "adversarial",
    "agent": "ux-ui",
    "hooks": ["ux-ui-guard"],
    "assertions": [
      { "type": "registry_agent", "id": "ux-ui", "fields": { "status": "active", "role": "specialist" } },
      { "type": "file_contains", "path": "skills/nino-ux-ui/SKILL.md", "pattern": "Define or review Nino user-facing screens" },
      { "type": "file_contains", "path": "rules/base/ux-ui.md", "pattern": "before\n`frontend-dev` implements" },
      { "type": "workflow_stage_order", "stages": ["surface-discovery", "ux-design", "frontend", "ux-review", "qa"] },
      { "type": "file_contains", "path": "hooks/ux-ui-guard.mjs", "pattern": "frontend must depend on ux-design" }
    ]
  }
]
